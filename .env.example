# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_mgmt?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_meeting_app
JWT_EXPIRES_IN=1800

# Email & Notification
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@company.com

# File Storage
STORAGE_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
