uot;\n}\nMEETING_EQUIPMENT {\nint meeting_id FK\nint equipment_id FK\nint quantity\n}\nCHECK_IN_LOG {\nint log_id PK\nint meeting_id FK\nint user_id FK\ndatetime check_in_time\ndatetime check_out_time\nstring qr_code_data\n}&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3-7QLrLslSGIAfJQI7VI-1">
